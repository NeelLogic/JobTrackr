# Database
DB_URL=jdbc:mysql://localhost:3306/jobtrackr_db?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-mysql-password
DB_POOL_SIZE=10

# JobTrackr authentication
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Google Sign-In
GOOGLE_CLIENT_ID=replace-with-your-sign-in-client-id.apps.googleusercontent.com

# Gmail OAuth and import
GOOGLE_GMAIL_CLIENT_ID=replace-with-your-gmail-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=replace-with-your-gmail-client-secret
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-your-existing-44-character-base64-key
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8080/api/integrations/gmail/callback
GMAIL_FRONTEND_CALLBACK_URL=http://localhost:4200/settings
GMAIL_OAUTH_STATE_TTL=10m
GMAIL_IMPORT_LOOKBACK_DAYS=180
GMAIL_IMPORT_MAX_MESSAGES=100
